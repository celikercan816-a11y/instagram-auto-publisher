# Meta App Dashboard > Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=

# OAuth redirect URI you registered in the App Dashboard (any URL you control or even
# a placeholder like https://localhost/ works, see README step 3)
IG_REDIRECT_URI=https://localhost/

# Filled in automatically by scripts/exchange_code_for_token.py after the manual login step
IG_ACCESS_TOKEN=

# Your Instagram professional account's numeric ID (printed by exchange_code_for_token.py)
IG_USER_ID=

# owner/repo, used to build public raw.githubusercontent.com URLs for media files
# committed under media/ (e.g. "myusername/instagram-auto-publisher")
GH_REPO=

# Branch that publish.yml runs on / that media is committed to (usually "main")
GH_BRANCH=main

# Only needed locally, once, to let scripts/update_github_secret.py push the
# refreshed token to GitHub Secrets automatically. A fine-grained GitHub PAT with
# "Secrets: read and write" permission on this repo. Never commit this.
GH_PAT=
